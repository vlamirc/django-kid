{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "django-ai-plugins": {
      "source": {
        "source": "github",
        "repo": "vintasoftware/django-ai-plugins"
      }
    }
  },
  "enabledPlugins": {
    "django-expert@django-ai-plugins": true,
    "django-safe-migration@django-ai-plugins": true,
    "django-reviewer@django-ai-plugins": true
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run python manage.py check:*)",
      "Bash(uv run python manage.py makemigrations:*)",
      "Bash(uv run python manage.py migrate:*)",
      "Bash(uv sync:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
