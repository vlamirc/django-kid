# Copie para .env e ajuste. O .env nunca vai para o Git.
DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# No Docker o host do banco é "db"; rodando fora do Docker use "localhost".
DATABASE_URL=postgres://blog:blog@db:5432/blog
# Mailpit (http://localhost:8025) captura os e-mails enviados em desenvolvimento.
EMAIL_URL=smtp://mailpit:1025
# Em desenvolvimento, desligue para testar o login de staff sem 2FA.
MFA_REQUIRED_FOR_PRIVILEGED_USERS=True
